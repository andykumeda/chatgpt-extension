{
  "manifest_version": 3,
  "name": "Local Codex Side Panel",
  "description": "Explicit page context and local Codex chat in a workspace you choose.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "nativeMessaging", "activeTab", "scripting"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_title": "Open Local Codex" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+Y" } } },
  "side_panel": { "default_path": "panel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
